/*
  Density field for Standard Air
  rho0 = p0 / (R * T0) = 100000 / (287.04 * 300) = 1.1613 kg/m3
*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      rho;
}

dimensions      [ 1 -3 0 0 0 0 0 ];   // kg/m3

internalField   uniform 1.1613;

boundaryField
{
    inlet
    {
        type    fixedValue;
        value   uniform 1.1613;
    }
    outlet
    {
        type    zeroGradient;
    }
    top
    {
        type            zeroGradient;
    }

    wedge
    {
        type            slip;
    }

    bottom
    {
        type            symmetryPlane;
    }

    frontAndBack
    {
        type            empty;
    }
}

