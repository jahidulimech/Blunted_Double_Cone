        type patch;
        faces
        (
            (11 10 22 23)
            (10 9 21 22)
            (9 8 20 21)
        );
    }


    wedge
    {
        type wall;
        faces
        (
            // Rounded nose: 1 -> 2
            (1 2 14 13)

            // First 6-degree ramp: 2 -> 3
            (2 3 15 14)

            // Second ramp: 3 -> 4
            (3 4 16 15)

            // Base vertical face: 4 -> 5
            (4 5 17 16)
        );
    }


    bottom
    {
        type symmetryPlane;
        faces
        (
            // Inlet-side bottom
            (0 1 13 12)

            // Wake bottom
            (5 6 18 17)
        );
