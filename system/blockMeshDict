// The 90-degree outer boundary is split into two 45-degree arcs (0-13 and 
// 13-12) to maintain perfectly valid hex-block topology without intersection.
// ============================================================================

scale 0.01;

// ============================================================================
// VERTICES
// ============================================================================

vertices
(
    // ------------------------------------------------------------------------
    // FRONT PLANE : z = 0 cm
    // ------------------------------------------------------------------------

    (-36.750000000  0.000000000  0.0)       // 0  (180 deg, C-shape start)
    (5.000000000   0.000000000  0.0)        // 1  nose start (Arc Center)
    (5.250000000   0.250000000  0.0)        // 2  nose end
    (35.250000000  3.403127000  0.0)        // 3  kink
    (56.050000000 10.200000000  0.0)        // 4  TE
    (56.050000000  0.000000000  0.0)        // 5  base
    (85.800000000  0.000000000  0.0)        // 6  outlet bottom
    (85.800000000 10.200000000  0.0)        // 7  outlet body height
    (85.800000000 42.000000000  0.0)        // 8  outlet top
    (56.050000000 42.000000000  0.0)        // 9
    (35.250000000 42.000000000  0.0)        // 10
    (5.250000000  42.000000000  0.0)        // 11 (90 deg, C-shape end)

    // ------------------------------------------------------------------------
