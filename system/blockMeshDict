    (85.800000000 42.000000000  0.100000000)    // 20
    (56.050000000 42.000000000  0.100000000)    // 21
    (35.250000000 42.000000000  0.100000000)    // 22
    (5.250000000  42.000000000  0.100000000)    // 23
);

// ============================================================================
// BLOCKS
// ============================================================================
blocks
(
    // Block 0 : upstream (Perfect C-Shape and arc nose)
    hex
    (0 1 2 11 12 13 14 23)
    (80 80 1)
    simpleGrading (1 1 1)

    // Block 1 :  first 6-degree wedge
    hex
    (2 3 10 11 14 15 22 23)
    (600 80 1)
    simpleGrading (1 1 1)

    // Block 2 : second wedge
    hex
    (3 4 9 10 15 16 21 22)
    (450 80 1)
    simpleGrading (1 1 1)

    // Block 3 : lower wake
    hex
    (5 6 7 4 17 18 19 16)
    (300 80 1)
    simpleGrading (1 1 1)

    // Block 4 : upper wake
    hex
    (4 7 8 9 16 19 20 21)
    (300 80 1)
    simpleGrading (1 1 1)
);

// ============================================================================
// EDGES
// ============================================================================
edges
(
    // ------------------------------------------------------------------------
    // EXACT 90-DEGREE C-SHAPE OUTER BOUNDARY (Split into two 45-deg arcs)
    // Center: (5.0, 0) | Radius: 42.0
    // ------------------------------------------------------------------------
    
    // First 45-degree segment (180 deg to 135 deg)
    arc 0 11
    (
        -24.447844050
         29.698484810
         0.0
    )

    arc 12 23
    (
        -24.447844050
         29.698484810
         0.100000000
    )

    // ------------------------------------------------------------------------
    // EXACT 90-DEGREE CIRCULAR NOSE
    // ------------------------------------------------------------------------
    arc 1 2
    (
        5.073223305
        0.176776695
        0.0
    )

    arc 13 14
    (
        5.073223305
        0.176776695
        0.100000000
    )
);

// ============================================================================
// BOUNDARIES
// ============================================================================
